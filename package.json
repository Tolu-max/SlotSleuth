{
    "name":  "slotsleuth",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --host 127.0.0.1",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "biome lint src/App.tsx src/main.tsx src/lib/solana.ts src/lib/solana.test.ts vite.config.ts",
                    "test":  "vitest run \u0026\u0026 node --test scripts/static-server.test.mjs",
                    "build":  "tsc --noEmit \u0026\u0026 vite build",
                    "preview":  "vite preview --host 127.0.0.1",
                    "start":  "node scripts/static-server.mjs dist"
                },
    "dependencies":  {
                         "@solana/kit":  "8.4.0",
                         "react":  "19.3.0",
                         "react-dom":  "19.3.0"
                     },
    "devDependencies":  {
                            "@biomejs/biome":  "2.5.15",
                            "@types/node":  "24.19.2",
                            "@types/react":  "19.2.7",
                            "@types/react-dom":  "19.2.3",
                            "@vitejs/plugin-react":  "6.1.2",
                            "typescript":  "5.9.3",
                            "vite":  "8.3.4",
                            "vitest":  "5.0.3"
                        }
}